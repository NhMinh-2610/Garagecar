PORT=8000
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRE_HOURS=24

# PostgreSQL Database
# Windows (pgAdmin): thay đổi port nếu cần (mặc định 5433)
DATABASE_URL=postgresql+asyncpg://garagecar:garagecar@localhost:5433/garagecar

# Docker Compose:
# DATABASE_URL=postgresql+asyncpg://garagecar:garagecar@db:5432/garagecar

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=INFO

# AI Provider: mock | openai | gemini | ollama
AI_PROVIDER=mock

# OpenAI (if AI_PROVIDER=openai)
OPENAI_API_KEY=

# Google Gemini (if AI_PROVIDER=gemini)
GEMINI_API_KEY=

# Ollama (if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
