PORT=8000
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRE_HOURS=24

# PostgreSQL: sua tai khoan, mat khau va port theo server dang dung.
# pgAdmin la cong cu quan tri; mat khau ket noi la cua tai khoan PostgreSQL.
DATABASE_URL=postgresql+asyncpg://garagecar:garagecar@localhost:5432/garagecar

# Docker Compose:
# DATABASE_URL=postgresql+asyncpg://garagecar:garagecar@db:5432/garagecar

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=INFO

# AI Provider: mock | openai | gemini | ollama
AI_PROVIDER=mock

# OpenAI (if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama (if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
